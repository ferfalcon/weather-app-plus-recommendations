{
  "name": "@weather-app-plus-recommendations/api",
  "private": true,
  "version": "0.0.0",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "pnpm -C ../.. --filter @weather-app-plus-recommendations/contracts build && tsc -p tsconfig.json && node dist/index.js",
    "build": "pnpm -C ../.. --filter @weather-app-plus-recommendations/contracts build && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "pnpm -C ../.. exec eslint apps/api/src apps/api/test apps/api/vitest.config.ts --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.vitest.json --noEmit",
    "test": "pnpm -C ../.. exec vitest run --config apps/api/vitest.config.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@weather-app-plus-recommendations/contracts": "workspace:*",
    "fastify": "^5.8.4"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.2"
  }
}
