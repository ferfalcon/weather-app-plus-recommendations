{
  "name": "weather-app-plus-recommendations",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "dev:web": "pnpm --filter @weather-app-plus-recommendations/web --if-present dev",
    "dev:api": "pnpm --filter @weather-app-plus-recommendations/api --if-present dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.0",
    "globals": "^17.4.0",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.4"
  }
}
